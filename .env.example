# Server only. Copy to .env; never expose these values through a VITE_ variable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional provider pin. Otherwise OpenRouter selects one compatible endpoint.
OPENROUTER_PROVIDER=
LUNAR_AI_MAX_TURNS=6
LUNAR_AI_MAX_TOOL_CALLS=12
LUNAR_AI_MAX_INPUT_TOKENS=64000
LUNAR_AI_MAX_OUTPUT_TOKENS=1600
LUNAR_AI_MAX_COST_USD=0.05
LUNAR_AI_HOURLY_COST_USD=0.50
LUNAR_AI_PROMPT_PRICE_CAP=0.50
LUNAR_AI_COMPLETION_PRICE_CAP=2.00
LUNAR_AI_TIMEOUT_S=30
LUNAR_AI_MAX_RETRIES=1
